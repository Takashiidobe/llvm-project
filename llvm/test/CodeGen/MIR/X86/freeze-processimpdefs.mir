# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-unknown-linux-gnu --run-pass=processimpdefs %s -o - | FileCheck %s
#
# Verify that ProcessImplicitDefs does NOT convert a FREEZE instruction to
# IMPLICIT_DEF even when its input comes from an IMPLICIT_DEF.
#
# canTurnIntoImplicitDef() only converts isCopyLike()/isInsertSubreg()/
# isRegSequence()/isPHI() instructions. FREEZE is none of those, so it must
# remain a FREEZE with an <undef> input operand after the pass runs.
#
# If FREEZE were converted to IMPLICIT_DEF here, every subsequent use of the
# frozen result could independently evaluate to a different value, violating the
# freeze guarantee that all uses see the same value.

---
name:            freeze_survives_processimpdefs
tracksRegLiveness: true
registers:
  - { id: 0, class: gr32 }
  - { id: 1, class: gr32 }
body:             |
  bb.0:
    ; The IMPLICIT_DEF for %0 is erased; its use in FREEZE gets the <undef>
    ; flag.  FREEZE itself is NOT converted to IMPLICIT_DEF.
    ; CHECK-LABEL: name: freeze_survives_processimpdefs
    ; CHECK: [[FREEZE:%[0-9]+]]:gr32 = FREEZE undef %0:gr32
    ; CHECK-NEXT: $eax = COPY [[FREEZE]]
    ; CHECK-NEXT: RET 0, implicit $eax
    %0:gr32 = IMPLICIT_DEF
    %1:gr32 = FREEZE %0
    $eax = COPY %1
    RET 0, implicit $eax
...
