# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 4
# RUN: llc -mtriple=x86_64-unknown-linux-gnu --run-pass=postrapseudos %s -o - | FileCheck %s --check-prefix=EXPAND
#
# Verify that ExpandPostRAPseudos replaces FREEZE with a COPY after register
# allocation.  The physical registers are already assigned at that point, so
# any subsequent copy-propagation of the resulting COPY is safe -- a single
# physical register always carries one consistent value, preserving the freeze
# semantic.

---
name:            freeze_expand_to_copy
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $edi


    ; EXPAND-LABEL: name: freeze_expand_to_copy
    ; EXPAND: liveins: $edi
    ; EXPAND-NEXT: {{  $}}
    ; EXPAND-NEXT: $eax = IMPLICIT_DEF
    ; EXPAND-NEXT: $ecx = MOV32rr $eax
    ; EXPAND-NEXT: RET 0, $ecx
    $eax = IMPLICIT_DEF
    $ecx = FREEZE $eax
    RET 0, $ecx
...
